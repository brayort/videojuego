{
  "name": "director-uan",
  "private": true,
  "description": "Fin de la Gestión: juego de cartas tipo Reigns para GDevelop 5",
  "scripts": {
    "build": "node tools/build/build.js && node tools/build/assets.js",
    "build:limpio": "node tools/build/build.js --limpio && node tools/build/assets.js",
    "sim": "node tools/sim/sim.js 7 20000",
    "balance": "node tools/balance/balance.js",
    "audio": "python tools/gen_audio.py",
    "placeholders": "python tools/gen_placeholders.py",
    "preview": "python tools/preview_layout.py",
    "check": "node tools/lint.js && node tools/build/build.js --destino=game.check.json && node tools/sim/sim.js 7 20000 game.check.json && node -e \"require('fs').unlinkSync('game.check.json')\"",
    "lint": "node tools/lint.js",
    "editor": "node tools/editor/server.js",
    "play": "node tools/play/server.js",
    "prod": "node tools/play/prod.js",
    "prod:ver": "node tools/play/servir.js",
    "html": "node tools/play/html.js",
    "cine": "python tools/ver_cine.py"
  },
  "devDependencies": {
    "docx": "^9.15.2"
  }
}
